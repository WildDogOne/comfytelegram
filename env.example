# Copy this file to .env and fill in values.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Where ComfyUI is reachable from wherever this bot process runs.
# If the bot runs on the same host as ComfyUI (typical for a local install),
# the default below is correct. If it runs elsewhere (e.g. inside a
# container without access to the host's localhost), point this at an
# address that actually reaches the ComfyUI host.
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_USE_TLS=false

# Where Ollama is reachable, for the "🔬 Analyze & Regenerate" button's
# natural-language image captioning (Qwen-VL, for checkpoints whose model
# profile sets "prompt_style": "natural"). Needs a vision-capable model
# pulled already (e.g. `ollama pull qwen3.5:4b`). Kept small by default
# since it has to coexist in VRAM with whatever checkpoint ComfyUI keeps
# resident — only bump to a bigger vision model (e.g. qwen3.6:27b) if the
# GPU running this has VRAM to spare.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_VISION_MODEL=qwen3.5:4b

# WD14 tagger settings, for the same button on checkpoints whose model
# profile sets "prompt_style": "tags" (booru/danbooru-tag-trained
# checkpoints). model.onnx + selected_tags.csv are downloaded from this
# Hugging Face repo on first use and cached in WD14_MODEL_DIR.
WD14_MODEL_REPO=SmilingWolf/wd-vit-tagger-v3
WD14_MODEL_DIR=models/wd14
WD14_TAG_THRESHOLD=0.35

# Optional: restrict bot usage to specific Telegram numeric user IDs
# (comma-separated). Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=
