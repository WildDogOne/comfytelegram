# Copy this file to .env and fill in values.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Where ComfyUI is reachable from wherever this bot process runs.
# If the bot runs on the same host as ComfyUI (typical for a local install),
# the default below is correct. If it runs elsewhere (e.g. inside a
# container without access to the host's localhost), point this at an
# address that actually reaches the ComfyUI host.
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_USE_TLS=false

# Optional: restrict bot usage to specific Telegram numeric user IDs
# (comma-separated). Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=
