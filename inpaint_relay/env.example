# Copy this file to .env and fill in values.
#
# (Named env.example rather than .env.example, and this note repeated here
# from the main repo's env.example, for the same reason: a local tooling
# rule blocks reads/writes of files literally named `.env*`.)

# Must match INPAINT_RELAY_SHARED_SECRET in comfytelegram's own .env — it
# authenticates comfytelegram's job-management calls (POST /jobs, GET
# /jobs/{token}/result, DELETE /jobs/{token}). Generate one with, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INPAINT_RELAY_SHARED_SECRET=

# How long (seconds) an undrawn or drawn-but-unpicked-up job lingers in
# memory before being dropped.
INPAINT_RELAY_JOB_TTL_SECONDS=1800

# Only used by docker-compose.example.yml's Traefik router label
# (Host(`${SUBDOMAIN}.${DOMAIN_NAME}`)) — irrelevant to the server itself,
# and not read by server.py. Match whatever public hostname you want this
# relay reachable at, e.g. SUBDOMAIN=inpaint DOMAIN_NAME=example.com for
# inpaint.example.com.
SUBDOMAIN=
DOMAIN_NAME=
